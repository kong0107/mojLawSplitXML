<法規內容>
  <條文>
    <條號>第 1 條</條號>
    <條文內容><![CDATA[本標準依規費法第十條第一項規定訂定之。]]></條文內容>
  </條文>
  <條文>
    <條號>第 2 條</條號>
    <條文內容><![CDATA[樹木保護專業人員之培訓或考選，其規費收費項目及金額如附表。]]></條文內容>
  </條文>
  <條文>
    <條號>第 3 條</條號>
    <條文內容><![CDATA[樹木保護專業人員證書之核發、換發、補發或重新核發，每件新臺幣一千五百元。]]></條文內容>
  </條文>
  <條文>
    <條號>第 4 條</條號>
    <條文內容><![CDATA[樹木保護相關研習課程之認可，每一課程每年新臺幣一千六百元。]]></條文內容>
  </條文>
  <條文>
    <條號>第 5 條</條號>
    <條文內容><![CDATA[本標準自發布日施行。]]></條文內容>
  </條文>
